# Database Connection (SQLite for zero-friction local run; seamless upgrade to PostgreSQL)
DATABASE_URL="file:./dev.db"

# AI Provider Configuration
# If AI_API_KEY is not set, the application runs in comprehensive Demo Mode with deterministic clinical homoeopathic reasoning
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
AI_PROVIDER="demo" # "gemini" | "openai" | "demo"

# Authentication Secret
AUTH_SECRET="bhms-ai-super-secret-jwt-key-for-mvp-session-management-2025"

# Storage
STORAGE_URL="./public/uploads"

# Speech to text
SPEECH_TO_TEXT_API_KEY=""

# Video Call Provider Configuration (DEMO_WEBRTC | AGORA | DAILY | TWILIO | 100MS)
# If left as DEMO_WEBRTC, runs in local browser WebRTC mode with interactive patient video simulation fallback
VIDEO_PROVIDER="DEMO_WEBRTC"
VIDEO_API_KEY=""
VIDEO_API_SECRET=""
VIDEO_SIGNALING_URL=""

# Node Environment
NODE_ENV="development"
